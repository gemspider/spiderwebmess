# Build-time configuration for the static export.
#
# None of these are secret. The map centre must match the data snapshot in
# public/data/ — a mismatch opens the map on empty space.
#
# Committed on purpose: the Vercel project then needs no dashboard configuration.

NEXT_PUBLIC_MAP_LAT=47.6926
NEXT_PUBLIC_MAP_LNG=16.0018
NEXT_PUBLIC_MAP_ZOOM=15
NEXT_PUBLIC_COMMUNITY_ID=054
NEXT_PUBLIC_COMMUNITY_NAME=AWV Mittleres Schwarzatal
